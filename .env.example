SERVER_PORT=8080
# Process topology is active by default. Standby mode must be supplied by the
# process environment before startup; it is intentionally not loaded from a
# development .env file because standby must not ingest application secrets.
RUNTIME_MODE=active

# Sensitive values accept either NAME or NAME_FILE. Prefer NAME_FILE for
# container secret mounts. Populate the direct values only for native
# development.
POSTGRES_AUTH_DB=
POSTGRES_USERS_DB=
DATABASE_SAVE_MESSAGES=false
CLIENT_NAME=evolution

GLOBAL_API_KEY=
# Exact browser origins allowed to call the API or open WebSockets. Same-host
# requests and non-browser clients without an Origin header remain allowed.
HTTP_ALLOWED_ORIGINS=https://web.whatsapp.com
# Comma-separated proxy IPs/CIDRs allowed to supply client IP headers. Keep
# empty when the API is directly exposed. For a same-host Caddy proxy use
# 127.0.0.1,::1 and keep the backend port private.
HTTP_TRUSTED_PROXIES=

# Optional keyed lookup digest for instance bearer tokens. Generate a secret
# with `openssl rand -base64 32` and store it in your secret manager. Keep the
# same key and version across replicas. Leaving the key empty keeps the legacy
# plaintext lookup path enabled for a rollback-safe staged rollout.
INSTANCE_TOKEN_HMAC_KEY=
INSTANCE_TOKEN_HMAC_KEY_VERSION=1
INSTANCE_TOKEN_BACKFILL_BATCH=100
INSTANCE_TOKEN_BACKFILL_MAX_BATCHES=10

# Additive canonical-contact rollout. This reads only the local whatsmeow LID
# mapping store; it never performs a live WhatsApp lookup. Keep disabled until
# migration 35 is deployed, then enable per environment for bounded backfill.
WA_CONTACT_IDENTITY_RECONCILIATION_ENABLED=false
# Persist instance-scoped phone/LID evidence observed directly from provider
# events. This stores personal data and remains disabled unless explicitly opted in.
WA_PHONE_IDENTITY_EVIDENCE_ENABLED=false
WA_PHONE_NUMBER_EXPOSURE_ENABLED=false
CONTACT_IDENTITY_BACKFILL_BATCH=100
CONTACT_IDENTITY_BACKFILL_MAX_BATCHES=10

# Canonical Conversation association backfill is independently gated and
# requires the canonical Contact flag above. Enabling it does not advertise the
# capability until Contacts/Chats/Messages, structural backfill, and unread
# validation are all ready for the individual instance.
WA_CANONICAL_CONVERSATION_IDENTITY_ENABLED=false
WA_CONVERSATION_APP_STATE_COMMANDS_ENABLED=false
WA_CONVERSATION_HISTORY_SYNC_ENABLED=false
CONVERSATION_BACKFILL_BATCH=100
CONVERSATION_BACKFILL_MAX_BATCHES=10

# Conservative operational defaults for outbound WhatsApp information queries.
# These values are configurable safeguards, not official WhatsApp limits.
WA_INFO_RATE=5/min
WA_INFO_BURST=3
WA_INFO_MAX_WAIT=5s
WA_INFO_COOLDOWN=90s

# Remote URLs supplied to media/profile/group/send operations are fetched through
# an SSRF guard. Use disabled as an emergency kill switch. allowlist additionally
# requires REMOTE_MEDIA_ALLOWED_HOSTS (comma-separated exact host names).
REMOTE_MEDIA_FETCH_POLICY=public_only
REMOTE_MEDIA_ALLOWED_HOSTS=
REMOTE_MEDIA_FETCH_TIMEOUT=15s
REMOTE_MEDIA_MAX_BYTES=33554432
# Full group snapshots repair missed events. Set to 0 to disable periodic runs;
# the initial guarded reconciliation on connection still runs.
WA_GROUP_RECONCILE_INTERVAL=6h
# Group List routes and capability remain disabled until the full stack is ready.
WA_GROUP_LISTS_ENABLED=false
# Advisory projection-only eligibility APIs. Requires WA_GROUP_LISTS_ENABLED.
WA_GROUP_LIST_ELIGIBILITY_ENABLED=false
# Feature-gated normalized Group Management public contract. Keep disabled
# until the matching Console contract is deployed.
WA_GROUP_MANAGEMENT_CONTRACT_ENABLED=false
# Shared-media Group photo command, device upload, and authenticated content
# preview. Requires the Group Management contract, WA_MEDIA_ASSETS_ENABLED=true,
# and private MinIO storage.
WA_GROUP_PHOTO_ASSETS_ENABLED=false
# Retain normalized projected message content for 90 days. Choose a duration
# that matches your legal basis, privacy notice, and operational requirements.
WA_MSG_RETENTION=2160h
# Retain safe durable event summaries for 30 days. This does not backfill
# events that occurred before durable persistence was enabled.
WA_EVENT_RETENTION=720h

# Operator-defined outbound message pacing. These conservative defaults are
# independent from WA_INFO_RATE and are not an official WhatsApp platform cap.
WA_OUTBOUND_RATE=30/min
WA_OUTBOUND_BURST=5
WA_OUTBOUND_MAX_WAIT=5s

# Durable campaign worker coordination and bounded retry policy. Message pacing
# still goes through the independent WA_OUTBOUND_* guard above.
WA_CAMPAIGN_BATCH=10
WA_CAMPAIGN_LEASE=2m
WA_CAMPAIGN_POLL_INTERVAL=1s
WA_CAMPAIGN_MAX_ATTEMPTS=3
WA_CAMPAIGN_RETRY_BASE=30s
# Emergency rollback flag. New campaigns are Group List-only by default. Set
# true temporarily only to restore the retired direct-recipient create shape;
# existing direct history and work do not require it.
WA_CAMPAIGN_DIRECT_CREATE_ENABLED=false
# Group campaign rollout; requires WA_GROUP_LISTS_ENABLED=true.
WA_CAMPAIGN_GROUP_TARGETS_ENABLED=false
WA_CAMPAIGN_GROUP_COOLDOWN=1h
WA_CAMPAIGN_CIRCUIT_DURATION=5m
WA_CAMPAIGN_RATE_PAUSE_THRESHOLD=3
WA_CAMPAIGN_FAILURE_PAUSE_THRESHOLD=10
# Complete image campaign gate: private upload, Group List creation, and worker
# delivery. Requires MinIO, WA_GROUP_LISTS_ENABLED, and
# WA_CAMPAIGN_GROUP_TARGETS_ENABLED.
WA_CAMPAIGN_IMAGE_CONTENT_ENABLED=false
CAMPAIGN_MEDIA_BUCKET=omniwa-campaign-media
WA_MEDIA_ASSETS_ENABLED=false
# Shared device-upload images for POST /send/media. Requires
# WA_MEDIA_ASSETS_ENABLED=true and MinIO.
WA_CHAT_IMAGE_CONTENT_ENABLED=false
# Live inbound image capture, asynchronous private download, and authenticated
# content streaming. Requires WA_MEDIA_ASSETS_ENABLED=true, MinIO, and a stable
# 32-byte descriptor key encoded as standard base64.
WA_INBOUND_IMAGE_CONTENT_ENABLED=false
MEDIA_DESCRIPTOR_KEY=
MEDIA_DESCRIPTOR_KEY_VERSION=1
MEDIA_DOWNLOAD_BATCH=4
MEDIA_DOWNLOAD_LEASE=3m
MEDIA_DOWNLOAD_POLL_INTERVAL=1s
MEDIA_DOWNLOAD_TIMEOUT=2m
MEDIA_DOWNLOAD_MAX_ATTEMPTS=3
MEDIA_DOWNLOAD_RETRY_BASE=30s
MEDIA_ASSET_BUCKET=omniwa-media-assets
MEDIA_ASSET_MAX_BYTES=8388608
MEDIA_ASSET_MAX_PIXELS=16000000
MEDIA_ASSET_UNBOUND_TTL=24h
CAMPAIGN_MEDIA_MAX_BYTES=8388608
CAMPAIGN_MEDIA_MAX_PIXELS=16000000
CAMPAIGN_MEDIA_UNBOUND_TTL=24h

# License gate. Defaults to enabled (upstream behavior): the API is blocked
# until the instance is activated. Set to false to run OmniWA GO independently,
# without the activation gate and without the remote heartbeat.
# LICENSE_GATE_ENABLED=true
# Readiness dependency gates are opt-in for a staged rollout. Each required
# dependency must pass two probes to recover and fail three probes to go unready.
READINESS_REQUIRE_USERS_DATABASE=false
READINESS_REQUIRE_EVENT_DELIVERY=false
READINESS_REQUIRE_MINIO=false

# License — headless auto-activation by email (only used when the license gate
# is enabled). Set this to the email you used in your first manual license
# registration. On startup, the service will silently call /v1/register/auto and
# skip the browser flow. Falls back to the manual flow if the email isn't
# registered yet. Leave empty (or unset) to keep the default behavior.
# EVOLUTION_OPERATOR_EMAIL=operator@example.com

WADEBUG=DEBUG
LOGTYPE=console
WEBHOOK_FILES=true

CONNECT_ON_STARTUP=true

OS_NAME=OmniWA GO

# Passkey (WebAuthn) pairing — required only for accounts that ask for a passkey
# when linking a device. Set this to the PUBLIC base URL of THIS API, reachable
# by the browser where WhatsApp Web opens (the Evolution Passkey Helper extension
# calls it from the web.whatsapp.com origin). Use a public domain in production,
# or a tunnel (ngrok/cloudflared) / LAN IP in development — NOT localhost if the
# browser runs on another machine. See docs/wiki/guias-api/passkey-pairing.md.
# PASSKEY_PUBLIC_URL=https://your-api.example.com

AMQP_URL=
AMQP_GLOBAL_ENABLED=false

WEBHOOK_URL=
# Exact hosts permitted for instance-specific webhooks. WEBHOOK_URL's own host
# is added automatically. Production deployments should allow HTTPS port 443
# only. Private destinations require explicit opt-in.
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOWED_PORTS=443
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_TIMEOUT=10s
WEBHOOK_MAX_REQUEST_BYTES=4194304
WEBHOOK_MAX_RESPONSE_BYTES=65536
# Optional deployment-wide HMAC authentication for operator-owned Webhook
# receivers. Generate exactly 32 random bytes: openssl rand -base64 32
WEBHOOK_SIGNATURE_ENABLED=false
WEBHOOK_SIGNATURE_SECRET=
WEBHOOK_SIGNATURE_KEY_ID=
# Webhook and RabbitMQ delivery always use the durable PostgreSQL outbox.
# These settings bound worker concurrency, leases, attempts, and retry delay.
EXTERNAL_EVENT_OUTBOX_BATCH=4
EXTERNAL_EVENT_OUTBOX_LEASE=45s
EXTERNAL_EVENT_OUTBOX_POLL_INTERVAL=1s
EXTERNAL_EVENT_OUTBOX_ATTEMPT_TIMEOUT=15s
EXTERNAL_EVENT_OUTBOX_STATE_TIMEOUT=5s
EXTERNAL_EVENT_OUTBOX_RETRY_BASE=5s
EXTERNAL_EVENT_OUTBOX_RETRY_MAX=15m

# Proxy Configuration
# PROXY_PROTOCOL can be http, https or socks5. If omitted, it is inferred from
# the port (1080/2080/42000-43000 → socks5; otherwise http).
# PROXY_PROTOCOL=http
# PROXY_HOST=proxy.example.com
# PROXY_PORT=8080
# PROXY_USERNAME=user
# PROXY_PASSWORD=secret

# Minio Configuration
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=evolution-media
MINIO_USE_SSL=false
