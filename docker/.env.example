# Environment for docker-compose.yml / docker-compose.full.yml.
# Copy to `.env` in this directory and edit. Run compose from this directory.

# Required immutable application image. Replace with a published digest.
OMNIWA_IMAGE=ghcr.io/hiepknor/omniwa-go@sha256:replace-with-published-digest
POSTGRES_IMAGE=postgres:15-alpine@sha256:replace-with-verified-digest
RABBITMQ_IMAGE=rabbitmq:4.2.7-management-alpine@sha256:replace-with-verified-digest
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z@sha256:replace-with-verified-digest

# Server
SERVER_PORT=4000
RUNTIME_MODE=active
CLIENT_NAME=omniwa
OS_NAME=OmniWA GO

# License gate: true = require activation (default), false = run independently
LICENSE_GATE_ENABLED=true
WA_LEGACY_GROUP_MYALL_ENABLED=true
READINESS_REQUIRE_USERS_DATABASE=false
READINESS_REQUIRE_EVENT_DELIVERY=false
READINESS_REQUIRE_MINIO=false

# Required secret files. Keep this directory ignored and restrict its
# permissions to the deployment operator. DSN credentials must match the
# PostgreSQL password file.
OMNIWA_GLOBAL_API_KEY_FILE=./secrets/global_api_key
OMNIWA_POSTGRES_PASSWORD_FILE=./secrets/postgres_password
OMNIWA_POSTGRES_AUTH_DSN_FILE=./secrets/postgres_auth_dsn
OMNIWA_POSTGRES_USERS_DSN_FILE=./secrets/postgres_users_dsn

# Required only with docker-compose.full.yml. The RabbitMQ config secret uses
# rabbitmq.conf syntax and owns default_user, default_pass, and default_vhost.
OMNIWA_AMQP_URL_FILE=./secrets/amqp_url
OMNIWA_RABBITMQ_CONFIG_FILE=./secrets/rabbitmq.conf
OMNIWA_MINIO_ROOT_USER_FILE=./secrets/minio_root_user
OMNIWA_MINIO_ROOT_PASSWORD_FILE=./secrets/minio_root_password

# Optional keyed instance-token lookup digest. Generate the secret with
# `openssl rand -base64 32` and keep the same key/version on every replica.
INSTANCE_TOKEN_HMAC_KEY=
INSTANCE_TOKEN_HMAC_KEY_VERSION=1
INSTANCE_TOKEN_BACKFILL_BATCH=100
INSTANCE_TOKEN_BACKFILL_MAX_BATCHES=10

# Set only when a private reverse proxy reaches the container. Use the actual
# proxy/gateway IP or CIDR; never trust all networks.
HTTP_TRUSTED_PROXIES=

# PostgreSQL (host "postgres" is the compose service; DBs auto-created)
POSTGRES_USER=postgres
POSTGRES_DB=postgres
DATABASE_SAVE_MESSAGES=false

# Logs
WADEBUG=INFO
LOGTYPE=console
LOG_DIRECTORY=/app/logs

# Connection
CONNECT_ON_STARTUP=false
WEBHOOK_FILES=true

# Events
EVENT_IGNORE_GROUP=false
EVENT_IGNORE_STATUS=true
QRCODE_MAX_COUNT=5

# Optional integrations (enabled by docker-compose.full.yml)
WEBHOOK_URL=
WEBHOOK_SIGNATURE_ENABLED=false
WEBHOOK_SIGNATURE_SECRET=
WEBHOOK_SIGNATURE_KEY_ID=
AMQP_URL=
AMQP_GLOBAL_ENABLED=false
NATS_URL=
NATS_GLOBAL_ENABLED=false
MINIO_ENABLED=false
